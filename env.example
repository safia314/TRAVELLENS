# --- MySQL root password ---
# Used ONLY by the mysql container itself during initialization (creating
# the database, running init scripts). Never given to the app. Keep this
# secret and different from DB_PASSWORD below.
DB_ROOT_PASSWORD=changeme-root-password

# --- App DB connection (non-root) ---
# Must match the password set for 'travellens_app' in
# docker/mysql/init/01-create-app-user.sql exactly.
DB_USER=travellens_app
DB_PASSWORD=changeme-app-password
DB_HOST=mysql
DB_NAME=travellens
